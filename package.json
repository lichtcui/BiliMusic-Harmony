{
  "name": "wisp-music",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "wisp-music native HarmonyOS phone application.",
  "license": "MIT",
  "ohos": {
    "org": "com.lichtcui",
    "buildTool": "hvigor",
    "directoryLevel": "project"
  },
  "scripts": {
    "test": "node scripts/test.mjs",
